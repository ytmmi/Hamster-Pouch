# === 依赖与构建产物 ===
node_modules/
target/
dist/

# 文档（本地规划资料，不入库）
docs/

# 本地工具生成物（代码图索引、AI 会话续接状态）
.codegraph/
.omo/

# 库存数据备份与修数据工具的中间产物（含本机路径与个人数据，不入库）
backups/

# pnpm 相关
.pnpm-store/
*.tgz

# === Rust / Cargo ===
# Cargo.lock 对应用（workspace 顶层是应用壳）应提交，不忽略

# === 前端 / Vite / Tauri ===
apps/desktop/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

