{
  "id": "dev.hamsterpouch.system.palette",
  "name": "系统色彩面板",
  "version": "0.1.0",
  "min_host_version": 1,
  "api_version": 1,
  "runtime": { "kind": "external-process" },
  "entry": "bin/palette.exe",
  "capabilities": ["ui.panel", "repo.read"],
  "contributions": [
    { "kind": "panel", "id": "palette.panel", "title_key": "plugin.palette.panel", "read_only": true }
  ],
  "data_queries": [{ "name": "colors", "returns": "rows" }],
  "events": [{ "id": "apply_color" }],
  "trust": { "requested": "system" }
}
