{
  "id": "dev.hamsterpouch.example.hello",
  "name": "Hello 示例插件",
  "version": "0.1.0",
  "min_host_version": 1,
  "api_version": 1,
  "runtime": { "kind": "external-process" },
  "entry": "bin/hello.exe",
  "capabilities": ["ui.panel", "repo.read"],
  "contributions": [
    {
      "kind": "panel",
      "id": "plugin.dev.hamsterpouch.example.hello.hello.panel",
      "title_key": "plugin.hello.panel",
      "category": "system",
      "has_class": false,
      "blueprint_node": "control",
      "read_only": true
    }
  ],
  "data_queries": [{ "name": "greetings", "returns": "rows" }],
  "events": [{ "id": "greet" }],
  "trust": { "requested": "local-dev" }
}
