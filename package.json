{
  "name": "hamster-pouch",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hamster-pouch/desktop dev",
    "typecheck": "pnpm --filter @hamster-pouch/desktop typecheck",
    "build": "pnpm --filter @hamster-pouch/desktop build",
    "app:build": "node tools/build.mjs --pipeline dev",
    "app:release": "node tools/build.mjs --pipeline release",
    "app:package": "node tools/package-build.mjs --pipeline dev",
    "app:package:release": "node tools/package-build.mjs --pipeline release",
    "version:next": "node tools/version.mjs --next --pipeline dev",
    "version:next:release": "node tools/version.mjs --next --pipeline release",
    "clean": "node tools/clean-build.mjs",
    "prepare": "node tools/install-hooks.mjs",
    "hooks:install": "node tools/install-hooks.mjs",
    "data:sync": "node tools/sync-user-data.mjs",
    "data:restore": "node tools/sync-user-data.mjs --restore",
    "generate:types": "cargo run -p hp-dto --bin generate",
    "generate:blueprint-fixture": "node tools/generate-blueprint-fixture.mjs",
    "check:blueprint-runtime": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-runtime-check.mjs",
    "check:blueprint-delete": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-delete-check.mjs",
    "check:blueprint-engine": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-engine-check.mjs",
    "check:blueprint-nodes": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-node-check.mjs",
    "check:blueprint-connect": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-connect-check.mjs",
    "check:blueprint-geometry": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-geometry-check.mjs",
    "check:blueprint-slots": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-slots-check.mjs",
    "check:blueprint-minimap": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-minimap-check.mjs",
    "check:blueprint-layout-sync": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/blueprint-layout-sync-check.mjs",
    "check:blueprint-fixture": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/generate-blueprint-fixture.mjs --check",
    "check:blueprint-pair": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/check-blueprint-pair.mjs",
    "check:controls": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/control-check.mjs",
    "gen:control-facts": "cargo run -q -p hp-core --bin dump-control-facts",
    "check:control-facts": "cargo run -q -p hp-core --bin dump-control-facts && git diff --exit-code -- packages/config/src/controlFacts.generated.ts",
    "check:panels": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/check-panels.mjs",
    "check:settings": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/check-settings.mjs",
    "gen:setting-facts": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/gen-setting-facts.mjs",
    "check:setting-facts": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/gen-setting-facts.mjs --check",
    "gen:panel-facts": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/gen-panel-facts.mjs",
    "check:panel-facts": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/gen-panel-facts.mjs --check",
    "check:render": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/check-render.mjs",
    "check:render:visual": "node tools/viewer-render-verify.mjs",
    "probe:render": "node tools/render-probe.mjs",
    "probe:render-swap": "node tools/render-swap-probe.mjs",
    "check:layouts": "node tools/layout-check.mjs",
    "check:types": "cargo run -p hp-dto --bin generate && git diff --exit-code -- packages/shared-types",
    "check:fmt": "node tools/check-fmt.mjs",
    "check:clippy": "node tools/check-clippy.mjs",
    "check:line-count": "node tools/check-line-count.mjs",
    "check:encoding": "node tools/check-encoding.mjs",
    "check:commands": "node tools/check-commands.mjs",
    "check:db-boundary": "node tools/check-db-boundary.mjs",
    "check:task-shell": "node tools/check-task-shell.mjs",
    "check:stores": "node tools/check-stores.mjs",
    "check:media-url": "node tools/check-media-url.mjs",
    "check:tree-panels": "node tools/check-tree-panels.mjs",
    "check:player-shared": "node tools/check-player-shared.mjs",
    "check:media-structure": "node tools/check-media-structure.mjs",
    "check:book-structure": "node tools/check-book-structure.mjs",
    "check:file-structure": "node tools/check-file-structure.mjs",
    "check:core-structure": "node tools/check-core-structure.mjs",
    "check:plugin-wire": "node --no-warnings --import ./tools/blueprint-check-register.mjs tools/check-plugin-wire.mjs",
    "check:hidden-console": "node tools/check-hidden-console.mjs",
    "check:bundled-runtime": "node tools/check-bundled-runtime.mjs",
    "check:event-names": "node tools/check-event-names.mjs",
    "check:doc-status": "node tools/check-doc-status.mjs",
    "check:version": "node tools/version.mjs --self-test",
    "check:build-plan": "node tools/build.mjs --self-test",
    "check:artifact-name": "node tools/artifact-name.mjs --self-test",
    "check:status": "node tools/check-status.mjs"
  }
}
